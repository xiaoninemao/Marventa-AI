APP_NAME=marventa_ai
DEBUG=true
JWT_SECRET=change-me-in-production-use-a-random-string
# Use a separate high-entropy secret for encrypted cookies and browser state.
DATA_ENCRYPTION_KEY=change-me-in-production-use-a-different-random-string
JWT_EXPIRE_MINUTES=1440
ENABLE_DEMO_USER=false
# DEMO_USERNAME=demo
# DEMO_PASSWORD=choose-a-local-development-password
# DEMO_EMAIL=demo@local.dev
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database and uploads
# Leave DB_PATH unset to use backend/data/market_insight.db.
# DB_PATH=backend/data/market_insight.db
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_SIZE_MB=100
MAX_IMAGE_SIZE_MB=10

# Preferred AI provider for market insight and content generation.
# OpenAI-compatible providers can be used by setting CASE_AI_BASE_URL and CASE_AI_MODEL.
CASE_AI_API_KEY=
CASE_AI_BASE_URL=https://api.deepseek.com
CASE_AI_MODEL=deepseek-v4-flash

# Required for case library AI analysis. Use a vision-capable model for images.
# Any compatible provider can be selected via the base URL and model.
CASE_ANALYSIS_AI_API_KEY=
CASE_ANALYSIS_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CASE_ANALYSIS_AI_MODEL=qwen3.6-flash

# Optional card modification override. Leave blank to reuse CASE_AI_*.
MODIFY_CARD_AI_API_KEY=
MODIFY_CARD_AI_BASE_URL=
MODIFY_CARD_AI_MODEL=
